# Copy only the variables for the provider you use. Never commit real keys.

GEMINI_API_KEY=your_key_here
NVIDIA_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Optional SDK defaults. Benchmark commands record their explicit settings.
RAG_EVAL_GENERATION_MODEL=provider_model_id
RAG_EVAL_REQUESTS_PER_MINUTE=10
RAG_EVAL_SIMILARITY_BACKEND=hashing
